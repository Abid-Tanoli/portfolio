# Server
PORT=4000

# --- CORS: comma-separated list of allowed frontend origins ---
# Local dev: http://localhost:5173
# Production: your Vercel deployment URL, e.g. https://portfolio-xxxx.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Contact form (Nodemailer + SMTP) ---
# Use any SMTP provider (Gmail app password, Brevo, Mailtrap for testing, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Abid Ali Tanoli Portfolio <your-smtp-username@example.com>"
# Where contact-form messages get delivered
CONTACT_TO=visionaryabidi@gmail.com

# --- MongoDB (optional) ---
# The backend runs fine without this. If provided, the server connects,
# tracks contact messages, and the /api/health route reports db status.
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/portfolio

# --- GitHub API (optional but recommended) ---
# Unauthenticated limit is 60 req/hr. A classic PAT raises it to 5000 req/hr.
# Create one at https://github.com/settings/tokens (no scopes needed).
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
