# Server
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Optional MongoDB logging for contact submissions.
# Leave empty to run without a database.
MONGO_URI=

# Optional GitHub token. Raises REST API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# SMTP settings for the contact form.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
