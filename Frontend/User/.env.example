# Backend API base URL.
# Local dev: leave empty (Vite proxies /api to http://localhost:4000)
# Production: leave empty when Nginx serves /api on the same domain, or use https://your-domain.com/api
VITE_API_URL=

# Public site URL (used for OG meta tags + sitemap)
VITE_SITE_URL=https://your-domain.com

# Resume PDF URL (defaults to /resume.pdf)
# VITE_RESUME_URL=
