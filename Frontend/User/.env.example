# Public site URL — used for canonical/OG meta and generated sitemap.xml/robots.txt
# (set to the live domain in production; the build falls back to the current
#  VPS host if this is unset).
VITE_SITE_URL=https://your-domain.com

# EmailJS browser configuration for the contact form.
VITE_EMAILJS_SERVICE_ID=service_your_id
VITE_EMAILJS_TEMPLATE_ID=template_your_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
