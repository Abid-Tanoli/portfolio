# Backend API base URL (with /api suffix).
# Local dev: leave empty (Vite proxies /api to http://localhost:4000)
# Production: leave empty when Nginx serves /api on the same domain, or use https://your-domain.com/api
VITE_API_BASE_URL=

# Admin front-end port. Keep this fixed across local environments to avoid CORS/login mismatches.
VITE_ADMIN_PORT=5176

# Public User site URL — used for "View Public Site" links in the Admin header.
# Local dev: leave empty (defaults to http://localhost:5173)
# Production: https://your-domain.com
VITE_USER_SITE_URL=
