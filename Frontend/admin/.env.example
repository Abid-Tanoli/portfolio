# Backend API base URL (with /api suffix).
# Local dev: leave empty (Vite proxies /api to http://localhost:4000)
# Production: https://your-backend.up.railway.app/api
VITE_API_BASE_URL=

# Public User site URL — used for "View Public Site" links in the Admin header.
# Local dev: leave empty (defaults to http://localhost:5173)
# Production: https://abidtanoli.vercel.app
VITE_USER_SITE_URL=
